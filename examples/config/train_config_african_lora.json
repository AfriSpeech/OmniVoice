{
    "llm_name_or_path": "/mnt/volume_d2wey28/models/OmniVoice-base",
    "init_from_checkpoint": "/mnt/volume_d2wey28/models/OmniVoice-base",
    "resume_from_checkpoint": "/mnt/volume_d2wey28/checkpoints/omnivoice_african_lora/checkpoint-400",

    "audio_vocab_size": 1025,
    "audio_mask_id": 1024,
    "num_audio_codebook": 8,
    "audio_codebook_weights": [8, 8, 6, 6, 4, 4, 2, 2],

    "drop_cond_ratio": 0.1,
    "prompt_ratio_range": [0.0, 0.3],
    "mask_ratio_range": [0.0, 1.0],
    "language_ratio": 0.9,
    "use_pinyin_ratio": 0.0,
    "use_ipa": true,
    "instruct_ratio": 0.0,
    "only_instruct_ratio": 0.0,

    "use_lora": true,
    "lora_r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.05,
    "use_rslora": true,
    "lora_target_modules": [
        "q_proj",
        "k_proj",
        "v_proj",
        "o_proj",
        "gate_proj",
        "up_proj",
        "down_proj"
    ],
    "lora_bias": "none",

    "learning_rate": 2e-5,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "steps": 270000,
    "seed": 42,
    "warmup_type": "ratio",
    "warmup_ratio": 0.03,

    "batch_tokens": 8192,
    "gradient_accumulation_steps": 1,
    "num_workers": 4,

    "mixed_precision": "bf16",
    "allow_tf32": true,
    "attn_implementation": "flex_attention",

    "logging_steps": 20,
    "eval_steps": 200,
    "save_steps": 200,
    "max_eval_batches": 30,
    "keep_last_n_checkpoints": 5,

    "early_stopping": true,
    "early_stopping_patience": 15,
    "early_stopping_threshold": 0.001
}
